# Copy to .env (git-ignored) and fill in. Every setting is optional.

# Which model backend the joiner assistant uses: auto | api | cli | offline
#   auto: api if ANTHROPIC_API_KEY is set, else the local `claude` CLI if installed, else offline
ASSISTANT_PROVIDER=auto

# Claude API key, only needed for the "api" provider. Never commit a real key.
ANTHROPIC_API_KEY=

# Model and effort (low | medium | high). claude-haiku-5-5 answers faster.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
